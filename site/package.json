{
  "name": "dev-digest-catalog-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Static catalog of the Claude Code plugin marketplace.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node ../scripts/build-index.mjs && vite",
    "dev:vite": "vite",
    "prebuild": "node ../scripts/build-index.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "dompurify": "3.4.16",
    "marked": "18.0.14",
    "minisearch": "7.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.1.4",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
